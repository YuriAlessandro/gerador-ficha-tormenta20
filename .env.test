# Valores FALSOS, usados apenas pelos testes (vitest roda em mode=test, e o
# Vite dá precedência a .env.test sobre .env). Existe porque o CI não tem .env:
# src/premium/config/firebase.ts chama getAuth() no topo do módulo, e o Firebase
# lança "auth/invalid-api-key" quando a apiKey é vazia — derrubando na coleta
# qualquer suíte que importe firebase transitivamente (7 suítes hoje).
# Nada aqui toca a rede: o Firebase só usa a chave numa operação de auth real,
# que os testes não executam. NÃO são credenciais.
VITE_FIREBASE_API_KEY=test-api-key
VITE_FIREBASE_AUTH_DOMAIN=test.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=test-project
VITE_FIREBASE_STORAGE_BUCKET=test-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

VITE_API_URL=http://localhost:3001
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_000000000000000000000000
